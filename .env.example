# Copy to .env and fill in
# RPC for the Kelvin MiniEVM appchain (populated by weave launch)
KELVIN_RPC_URL=
KELVIN_CHAIN_ID=
KELVIN_EXPLORER_URL=

# Deployer key — testnet only, never mainnet
DEPLOYER_PRIVATE_KEY=

# Deployed contract addresses (fill after scripts/deploy.ts)
LB_FACTORY_ADDRESS=
LB_ROUTER_ADDRESS=
POSITION_MANAGER_ADDRESS=
FEE_ROUTER_ADDRESS=
MOCK_USDC_ADDRESS=
MOCK_ETH_ADDRESS=
MOCK_INIT_ADDRESS=

# Frontend public vars (duplicates above, prefixed for Next.js exposure)
NEXT_PUBLIC_KELVIN_RPC_URL=
NEXT_PUBLIC_KELVIN_CHAIN_ID=
NEXT_PUBLIC_KELVIN_EXPLORER_URL=
NEXT_PUBLIC_LB_ROUTER_ADDRESS=
NEXT_PUBLIC_POSITION_MANAGER_ADDRESS=
